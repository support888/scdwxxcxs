/* ============================================================================
 * LLS俱乐部 - 我的样式 (迭代版本)
 * ----------------------------------------------------------------------------
 * 【样式锚点】修改样式时关注以下模块:
 *   • .mine-header      : 顶部紫色渐变头像区
 *   • .user-card        : 用户信息卡(头像/昵称/ID)
 *   • .grid-menus       : 九宫格菜单(5格带背景色)
 *   • .order-card       : 订单卡片
 * ============================================================================ */
.mine-page {
  position: relative;
}

/* ---------- 紫色渐变头部 ---------- */
.mine-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 560rpx;
  background: linear-gradient(165deg, #8b6ce0 0%, #7d5bd4 30%, #4a3a8a 62%, #131c3d 100%);
  z-index: 1;
}

.mine-header::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(115deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 45%);
  pointer-events: none;
}

.nav-bar-inner {
  height: 44px;
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.setting-btn {
  position: absolute;
  top: 40rpx;
  right: 34rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 用户信息 ---------- */
.user-row {
  display: flex;
  align-items: center;
  padding: 30rpx 34rpx 0;
}

.user-avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #2b3a67, #173054);
  border: 4rpx solid rgba(255, 255, 255, 0.65);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(20, 10, 60, 0.35);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 64rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.user-name-row {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  max-width: 320rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-edit-icon {
  margin-left: 14rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.user-chips {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  margin-right: 14rpx;
  margin-bottom: 10rpx;
}

.chip-phone {
  background: rgba(255, 255, 255, 0.22);
  color: #f3ecff;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.chip-id {
  background: rgba(255, 255, 255, 0.16);
  color: #e9e2fb;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.chip-copy {
  margin-left: 8rpx;
  font-size: 22rpx;
}

/* ---------- 功能宫格 ---------- */
.grid-wrap {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.grid-card {
  width: calc((100% - 30rpx) / 3);
  background: linear-gradient(160deg, rgba(16, 28, 51, 0.9), rgba(20, 33, 61, 0.9));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 34rpx 0 28rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(0, 10, 40, 0.35);
}

.grid-card:nth-child(3n) {
  margin-right: 0;
}

.grid-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 18rpx;
}

.grid-text {
  font-size: 26rpx;
  color: #e6ecf5;
}
