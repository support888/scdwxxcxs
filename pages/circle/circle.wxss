/* LLS俱乐部 - 圈子 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background: rgba(10, 20, 39, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1rpx solid rgba(0, 229, 255, 0.1);
}

.nav-bar-inner {
  height: 44px;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title { font-size: 36rpx; font-weight: 800; }

.circle-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.circle-card {
  display: flex;
  align-items: center;
}

.circle-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
}

.logo-cyan { background: linear-gradient(135deg, #04586f, #0e8aa8); }
.logo-purple { background: linear-gradient(135deg, #3a2270, #6e45b8); }
.logo-gold { background: linear-gradient(135deg, #6b5410, #a8862b); }

.circle-info { flex: 1; min-width: 0; margin-left: 24rpx; }

.circle-name { font-size: 30rpx; font-weight: 700; color: #fff; }

.circle-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5a6b85;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.circle-count {
  font-size: 22rpx;
  color: #00e5ff;
  background: rgba(0, 229, 255, 0.08);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}
