
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--lls-bg);
}

.nav-bar-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

/* ---------- 搜索栏 ---------- */
.search-panel {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx 16rpx;
  background: var(--lls-bg);
  box-sizing: border-box;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 36rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.search-icon {
  font-size: 28rpx;
  color: var(--lls-text-2);
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.search-ph {
  color: #6a7a95;
}

.bell-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-left: 20rpx;
  border-radius: 50%;
  background: rgba(0, 229, 255, 0.12);
  border: 1rpx solid rgba(0, 229, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-icon {
  font-size: 32rpx;
}

.bell-dot {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--lls-cyan);
  box-shadow: 0 0 8rpx rgba(0, 229, 255, 0.8);
}

/* ---------- Banner ---------- */
.banner-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(120deg, #eaf3ff 0%, #dbe8ff 55%, #cfe0ff 100%);
  border-radius: 28rpx;
  padding: 30rpx 32rpx;
  overflow: hidden;
  min-height: 240rpx;
  box-sizing: border-box;
}

.banner-brand {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #5a6b8c;
  margin-bottom: 12rpx;
}

.brand-dot {
  margin-right: 8rpx;
  font-size: 22rpx;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a2b4a;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.banner-icons {
  display: flex;
}

.banner-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 22rpx;
}

.banner-icon-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(30, 60, 120, 0.18);
}

.g-orange { background: linear-gradient(135deg, #ffb35c, #ff8a3d); }
.g-green { background: linear-gradient(135deg, #4fd39a, #22b07d); }
.g-purple { background: linear-gradient(135deg, #9a7bff, #6f5ae0); }
.g-red { background: linear-gradient(135deg, #ff6d7a, #f43f5e); }

.banner-icon-text {
  font-size: 20rpx;
  color: #4a5a7a;
  white-space: nowrap;
}

/* banner 右侧装饰 */
.banner-deco {
  position: relative;
  width: 180rpx;
  height: 200rpx;
}

.deco-phone {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 150rpx;
  height: 190rpx;
  background: linear-gradient(160deg, #ffffff, #d9e6ff);
  border-radius: 24rpx;
  border: 1rpx solid rgba(120, 150, 220, 0.35);
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  transform: rotate(6deg);
  box-shadow: 0 10rpx 24rpx rgba(60, 100, 200, 0.2);
}

.deco-line {
  height: 14rpx;
  border-radius: 7rpx;
  background: #b9cdef;
  margin-bottom: 16rpx;
}

.deco-line.w1 { width: 80%; background: #7fa8f0; }
.deco-line.w2 { width: 60%; }
.deco-line.w3 { width: 70%; background: #cfe0ff; }

.deco-coin {
  position: absolute;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd76e, #ffb63d);
  color: #a06a00;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(255, 180, 60, 0.45);
}

.deco-coin.c1 { top: 8rpx; right: 10rpx; }
.deco-coin.c2 { top: 70rpx; right: 110rpx; }

/* ---------- 平台公告 ---------- */
.notice-bar {
  display: flex;
  align-items: center;
  background: rgba(0, 229, 255, 0.06);
  border: 1rpx solid rgba(0, 229, 255, 0.18);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
}

.notice-label {
  color: #ff5d6c;
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
}

.notice-horn {
  margin: 0 12rpx;
  font-size: 24rpx;
}

.notice-viewport {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

.notice-scroll {
  display: inline-block;
  color: #ffd76e;
  font-size: 24rpx;
  animation: notice-marquee 14s linear infinite;
  padding-left: 100%;
}

@keyframes notice-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
}

/* ---------- 主 tab ---------- */
.main-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0 6rpx;
  width: 100%;
  box-sizing: border-box;
}

.main-tab-line {
  flex: 0 0 80rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 0 20rpx;
}

.main-tab {
  flex: 0 0 auto;
  font-size: 32rpx;
  color: var(--lls-text-2);
  padding: 8rpx 6rpx;
  position: relative;
  text-align: center;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.main-tab.active {
  color: var(--lls-cyan);
  font-weight: bold;
  text-shadow: 0 0 16rpx rgba(0, 229, 255, 0.6);
}

.main-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -4rpx;
  width: 56rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--lls-cyan);
  box-shadow: 0 0 12rpx rgba(0, 229, 255, 0.8);
}

/* ---------- 筛选 pill ---------- */
.filter-row {
  display: flex;
  margin-top: 16rpx;
}

.filter-pill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #cdd6e6;
  font-size: 26rpx;
  white-space: nowrap;
}

.filter-pill:last-child {
  margin-right: 0;
}

.pill-arrow {
  font-size: 18rpx;
  margin-left: 8rpx;
  color: #8fa0bd;
}

/* ---------- 下拉面板 ---------- */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
}

.dropdown-panel {
  position: relative;
  z-index: 91;
  margin: 8rpx 30rpx 0;
  background: var(--lls-card);
  border: 1rpx solid var(--lls-border);
  border-radius: 20rpx;
  overflow: hidden;
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #cdd6e6;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item.selected {
  color: var(--lls-cyan);
}

.dropdown-check {
  font-size: 26rpx;
}

/* ---------- 护航员卡片 ---------- */
.player-list {
  margin-top: 20rpx;
}

.player-card {
  display: flex;
  align-items: center;
  background: linear-gradient(160deg, var(--lls-card), var(--lls-card-2));
  border: 1rpx solid var(--lls-border);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.player-avatar-wrap {
  position: relative;
  margin-right: 22rpx;
}

.player-avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #2b3a67, #173054);
  border: 1rpx solid var(--lls-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--lls-cyan);
  overflow: hidden;
}

.avatar-ribbon {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  background: linear-gradient(90deg, #ff6d7a, #f43f5e);
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx 10rpx 10rpx 2rpx;
  box-shadow: 0 4rpx 10rpx rgba(244, 63, 94, 0.4);
}

.player-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-sub {
  font-size: 24rpx;
  color: var(--lls-text-2);
  margin: 10rpx 0 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-meta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.player-score {
  color: var(--lls-cyan);
  font-size: 24rpx;
}

.player-orders {
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: rgba(0, 229, 255, 0.12);
  border: 1rpx solid rgba(0, 229, 255, 0.25);
  color: var(--lls-cyan);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.player-orders.female {
  background: rgba(215, 149, 251, 0.12);
  border-color: rgba(215, 149, 251, 0.3);
  color: var(--lls-pink);
}

/* 接单量:与性别徽章分离后独立展示 */
.player-orders-count {
  color: rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
}

.rank-badge {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
}

/* ---------- 注册用户卡片(热门推荐) ---------- */
.player-avatar-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 22rpx;
  display: block;
  background: #0b1a2b;
}

.user-follow-btn {
  align-self: flex-start;
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  background: linear-gradient(90deg, #00e5ff, #4facfe);
  box-shadow: 0 4rpx 12rpx rgba(0, 229, 255, 0.35);
}

.user-follow-btn.followed {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--lls-border);
  color: var(--lls-text-2);
  box-shadow: none;
}

.rank-myth {
  background: linear-gradient(90deg, #ff9a3d, #f43f5e);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 94, 0.4);
}

.rank-ace {
  background: linear-gradient(90deg, #4facfe, #7c5cff);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(79, 172, 254, 0.4);
}

/* ---------- 游戏海报轮播 ---------- */
.game-swiper {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--lls-border);
  box-shadow: 0 8rpx 24rpx rgba(0, 229, 255, 0.12);
}

.game-swiper .wx-swiper-dot {
  width: 12rpx;
  height: 12rpx;
}

.game-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.game-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.6s ease;
}

.game-pattern {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.05) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  opacity: 0.5;
  pointer-events: none;
}

.game-info {
  position: relative;
  z-index: 2;
  padding: 32rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  box-sizing: border-box;
  width: 65%;
}

.game-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.game-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  backdrop-filter: blur(4rpx);
}

.game-hot {
  color: #ffd76e;
  font-size: 22rpx;
  font-weight: bold;
  text-shadow: 0 0 8rpx rgba(255, 215, 110, 0.5);
}

.game-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
  line-height: 1.1;
}

.game-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-cta {
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 8rpx 22rpx;
  background: rgba(0, 0, 0, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 30rpx;
  backdrop-filter: blur(6rpx);
}

.game-cta-btn {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.game-cta-arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #00e5ff;
  font-weight: bold;
}

.game-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 160rpx;
  line-height: 1;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.45));
  z-index: 2;
  opacity: 0.95;
}

.game-corner {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 2rpx;
  font-weight: 600;
  z-index: 2;
  transform: scale(0.85);
  transform-origin: right bottom;
}

/* ---------- 陪玩推广滚动字幕(独立于平台公告,粉紫主题) ---------- */
.promo-wrap {
  margin-top: -8rpx;
}

.promo-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, rgba(215, 149, 251, 0.12), rgba(255, 93, 108, 0.08));
  border: 1rpx solid rgba(215, 149, 251, 0.3);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  box-shadow: 0 0 18rpx rgba(215, 149, 251, 0.1) inset;
}

.promo-label {
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #d795fb, #ff5d6c);
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 8rpx rgba(215, 149, 251, 0.4);
  white-space: nowrap;
  flex-shrink: 0;
}

.promo-horn {
  margin: 0 14rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.promo-viewport {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.promo-scroll {
  display: inline-block;
  color: #ffd76e;
  font-size: 24rpx;
  font-weight: 600;
  animation: promo-marquee 18s linear infinite;
  padding-left: 100%;
  text-shadow: 0 0 8rpx rgba(255, 215, 110, 0.3);
}

.promo-cta {
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(215, 149, 251, 0.15);
  border: 1rpx solid rgba(215, 149, 251, 0.35);
  color: #d795fb;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}

@keyframes promo-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
}
