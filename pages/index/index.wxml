<view class="app-container">
  <view class="tech-element tech-lines"></view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-bar-inner">
      <view class="nav-title">LLS俱乐部-首页</view>
    </view>
  </view>

  <!-- 搜索栏 + 消息铃铛 -->
  <view class="search-panel" style="top:{{statusBarHeight + 44}}px;">
    <view class="search-box" bindtap="gotoSearch">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索用户昵称 / ID" placeholder-class="search-ph" disabled />
    </view>
    <view class="bell-wrap" bindtap="gotoMessage">
      <text class="bell-icon">🔔</text>
      <view class="bell-dot"></view>
    </view>
  </view>
  <view style="height:{{statusBarHeight + 108}}px;"></view>

  <!-- 游戏海报轮播(自动滚动) -->
  <view class="lls-section lls-fade-up">
    <swiper class="game-swiper"
      indicator-dots="{{true}}"
      autoplay="{{true}}"
      circular="{{true}}"
      interval="3500"
      duration="600"
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#00e5ff"
      bindchange="onSwiperChange">
      <swiper-item wx:for="{{gameBanners}}" wx:key="id"
        class="game-slide"
        data-game="{{item}}"
        bindtap="onBannerTap">
        <view class="game-bg" style="background:{{item.gradient}};"></view>
        <view class="game-pattern"></view>
        <view class="game-info">
          <view class="game-tag-row">
            <text class="game-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
            <text class="game-hot" wx:if="{{item.hot}}">🔥 {{item.hot}}</text>
          </view>
          <view class="game-title">{{item.name}}</view>
          <view class="game-sub">{{item.subtitle}}</view>
          <view class="game-cta">
            <text class="game-cta-btn">立即体验</text>
            <text class="game-cta-arrow">→</text>
          </view>
        </view>
        <view class="game-icon">{{item.icon}}</view>
        <view class="game-corner" wx:if="{{item.corner}}">{{item.corner}}</view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 平台公告跑马灯 -->
  <view class="lls-section">
    <view class="notice-bar" bindtap="showPop">
      <text class="notice-label">平台公告</text>
      <text class="notice-horn">📢</text>
      <view class="notice-viewport">
        <text class="notice-scroll">{{announcement}}</text>
      </view>
    </view>
  </view>

  <!-- 陪玩推广滚动字幕(在平台公告下方,不改动原公告) -->
  <view class="lls-section promo-wrap">
    <view class="promo-bar" bindtap="gotoCompanionPlay">
      <text class="promo-label">陪玩推广</text>
      <text class="promo-horn">🎮</text>
      <view class="promo-viewport">
        <text class="promo-scroll">{{promoText}}</text>
      </view>
      <text class="promo-cta">GO ›</text>
    </view>
  </view>

  <!-- 热门推荐 / 我的关注 -->
  <view class="main-tabs">
    <view class="main-tab-line"></view>
    <view class="main-tab {{tabActive === 0 ? 'active' : ''}}" data-index="0" bindtap="chooseTab">热门推荐</view>
    <view class="main-tab-line"></view>
    <view class="main-tab {{tabActive === 1 ? 'active' : ''}}" data-index="1" bindtap="chooseTab">我的关注</view>
    <view class="main-tab-line"></view>
  </view>

  <!-- 筛选条件 -->
  <view class="lls-section filter-row">
    <view class="filter-pill" data-dropdown="sort" bindtap="toggleDropdown">
      {{sortText}} <text class="pill-arrow">▼</text>
    </view>
    <view class="filter-pill" data-dropdown="gender" bindtap="toggleDropdown">
      {{genderText}} <text class="pill-arrow">▼</text>
    </view>
    <view class="filter-pill" data-dropdown="service" bindtap="toggleDropdown">
      {{serviceText}} <text class="pill-arrow">▼</text>
    </view>
  </view>

  <!-- 下拉面板 -->
  <view class="dropdown-mask" wx:if="{{dropdown}}" bindtap="closeDropdown"></view>
  <view class="dropdown-panel" wx:if="{{dropdown}}">
    <view wx:for="{{dropdownList}}" wx:key="id"
      class="dropdown-item {{dropdownValue === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}" data-text="{{item.text}}" catchtap="pickDropdown">
      {{item.text}}<text class="dropdown-check" wx:if="{{dropdownValue === item.id}}">✓</text>
    </view>
  </view>

  <!-- 热门推荐(注册用户+护航员) / 我的关注 -->
  <view class="lls-section player-list">
    <block wx:if="{{tabActive === 0 || followList.length > 0}}">
      <view wx:for="{{tabActive === 0 ? playerList : followList}}" wx:key="id" class="player-card lls-fade-up"
        data-id="{{item.id}}" data-isuser="{{item.isUser}}" bindtap="gotoPlayer">
        <view class="player-avatar-wrap">
          <image wx:if="{{item.avatar}}" class="player-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="player-avatar">{{item.avatarText}}</view>
          <view class="avatar-ribbon">{{item.ribbon}}</view>
        </view>
        <view class="player-info">
          <view class="player-name">{{item.name}}</view>
          <view class="player-sub">{{item.sub}}</view>
          <view class="player-meta-row">
            <text wx:if="{{item.isUser}}" class="player-score">👥粉丝：{{item.fansCount}}</text>
            <text wx:else class="player-score">★评分：{{item.score}}</text>
            <!-- 性别徽章:只显示符号,不再拼接数字 -->
            <text class="player-orders {{item.gender === 'f' ? 'female' : ''}}">{{item.gender === 'f' ? '♀' : '♂'}}</text>
            <!-- 接单量:独立展示,与性别分离 -->
            <text wx:if="{{!item.isUser}}" class="player-orders-count">已接{{item.orders || 0}}单</text>
          </view>
        </view>
        <view wx:if="{{item.isUser}}" class="user-follow-btn {{item.followed ? 'followed' : ''}}"
          catchtap="onFollowUser" data-index="{{index}}">{{item.followed ? '已关注' : '+ 关注'}}</view>
        <view wx:else class="rank-badge {{item.rank === '神话' ? 'rank-myth' : 'rank-ace'}}">{{item.rank}}</view>
      </view>
    </block>
    <view class="lls-empty" wx:if="{{tabActive === 1 && followList.length === 0}}">暂无关注的人,去热门推荐看看吧~</view>
  </view>

  <view style="height:40rpx;"></view>
</view>
