/* LLS俱乐部 - 登录 */
.login-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 80rpx;
  min-height: 100vh;
}

.login-logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 140rpx;
}

.login-logo {
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #fff;
  background: linear-gradient(135deg, #04304a, #0e7d95);
  border: 2rpx solid rgba(0, 229, 255, 0.5);
  box-shadow: 0 0 60rpx rgba(0, 229, 255, 0.35);
}

.login-name {
  margin-top: 40rpx;
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(90deg, #00e5ff, #ae8eff);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.login-slogan {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #5a6b85;
  letter-spacing: 4rpx;
}

.login-btn { width: 100%; }

/* ---------- 注册资料表单(头像 + 昵称) ---------- */
.login-form {
  display: flex;
  align-items: center;
  margin: 0 auto 60rpx;
  padding: 30rpx 40rpx;
  border-radius: 28rpx;
  background: rgba(14, 32, 48, 0.6);
  border: 2rpx solid rgba(0, 229, 255, 0.18);
}

.avatar-choose {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  border: 2rpx dashed rgba(0, 229, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  line-height: 1;
}

.avatar-choose::after { border: none; }

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.avatar-ph-icon { font-size: 40rpx; }
.avatar-ph-text { font-size: 20rpx; color: #5a6b85; }

.nick-input {
  flex: 1;
  margin-left: 30rpx;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 20rpx;
  background: rgba(6, 18, 30, 0.7);
  border: 2rpx solid rgba(0, 229, 255, 0.12);
  color: #e8f4ff;
  font-size: 30rpx;
}

.nick-ph { color: #5a6b85; }

.agree-row {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
}

.agree-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #5a6b85;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}

.agree-check.checked {
  background: #00e5ff;
  border-color: #00e5ff;
}

.agree-text {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #8b9bb4;
}

.agree-link { color: #00e5ff; }
