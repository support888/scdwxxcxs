<view class="app-container set-page">
  <view class="tech-element tech-lines"></view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-bar-inner">
      <view class="nav-back" bindtap="goBack">‹</view>
      <view class="nav-title">设置</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>
  <view style="height:{{statusBarHeight + 44}}px;"></view>

  <!-- 卡1：账户 -->
  <view class="set-card lls-fade-up">
    <view class="set-row" bindtap="gotoAccount">
      <text class="row-label">账户与资料</text>
      <view class="row-right">
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="set-row">
      <text class="row-label">手机号</text>
      <view class="row-right">
        <text class="row-value">{{profile.phone || '未绑定'}}</text>
      </view>
    </view>

    <view class="set-row" bindtap="gotoRenzheng">
      <text class="row-label">实名认证</text>
      <view class="row-right">
        <text class="row-value">{{profile.verifyStatus || '未认证'}}</text>
      </view>
    </view>

    <view class="set-row" bindtap="gotoIncome">
      <text class="row-label">我的收入</text>
      <view class="row-right">
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 卡2：偏好设置 -->
  <view class="set-card lls-fade-up">
    <view class="set-row">
      <view class="row-main">
        <text class="row-label">个性化内容推荐</text>
        <text class="row-desc">关闭后你将不再收到针对个人兴趣的推荐内容</text>
      </view>
      <switch class="row-switch" color="#3b9bff" checked="{{settings.recommend}}"
        data-key="recommend" bindchange="onSwitch" />
    </view>

    <view class="set-row">
      <text class="row-label">推送通知（点评点赞聊天）</text>
      <switch class="row-switch" color="#3b9bff" checked="{{settings.pushNotify}}"
        data-key="pushNotify" bindchange="onSwitch" />
    </view>

    <view class="set-row">
      <text class="row-label">是否允许查看我的关注</text>
      <switch class="row-switch" color="#3b9bff" checked="{{settings.showFollow}}"
        data-key="showFollow" bindchange="onSwitch" />
    </view>

    <view class="set-row">
      <text class="row-label">是否允许查看我的粉丝</text>
      <switch class="row-switch" color="#3b9bff" checked="{{settings.showFans}}"
        data-key="showFans" bindchange="onSwitch" />
    </view>
  </view>

  <!-- 卡3：账号操作 -->
  <view class="set-card lls-fade-up">
    <view class="set-row" bindtap="onCancelAccount">
      <text class="row-label">账号注销</text>
      <view class="row-right">
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="set-row" bindtap="onLogout">
      <text class="row-label row-danger">退出登录</text>
      <view class="row-right">
        <text class="row-arrow row-danger">›</text>
      </view>
    </view>
  </view>

  <view style="height:60rpx;"></view>
</view>
