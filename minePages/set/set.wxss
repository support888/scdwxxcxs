/* ============================================================================
 * LLS俱乐部 - 设置样式
 * ----------------------------------------------------------------------------
 * 【样式锚点】修改样式时关注以下模块:
 *   • .nav-bar        : 顶部导航
 *   • .set-card       : 分组卡片(账户 / 偏好 / 账号操作)
 *   • .set-row        : 单行设置项(左标题 + 右值/箭头/开关)
 *   • .row-desc       : 副说明文字(灰色小字)
 *   • .row-switch     : 右侧开关
 *   • .row-danger     : 危险操作(退出登录/注销)
 * ============================================================================ */
.set-page {
  position: relative;
  padding-bottom: 0;
}

/* ---------- 导航栏 ---------- */
.nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--lls-bg);
}

.nav-bar-inner {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

/* ---------- 分组卡片 ---------- */
.set-card {
  position: relative;
  z-index: 1;
  margin: 24rpx 28rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(160deg, rgba(18, 30, 54, 0.95), rgba(14, 24, 44, 0.95));
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 10rpx 26rpx rgba(0, 8, 30, 0.35);
}

/* ---------- 单行 ---------- */
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 22rpx 30rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.set-row:last-child {
  border-bottom: none;
}

.set-row:active {
  background: rgba(255, 255, 255, 0.03);
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row-label {
  font-size: 30rpx;
  color: #eaf0fa;
  line-height: 1.4;
}

.row-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.38);
  line-height: 1.5;
}

.row-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.row-value {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.45);
}

.row-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.28);
  font-weight: 300;
  line-height: 1;
}

.row-danger {
  color: #ff5b64;
}

/* ---------- 开关 ---------- */
.row-switch {
  flex-shrink: 0;
  margin-left: 20rpx;
  transform: scale(0.9);
  transform-origin: right center;
}
