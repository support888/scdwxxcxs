/* ============================================================================
 * LLS俱乐部 - 发布动态样式 (迭代版本)
 * ----------------------------------------------------------------------------
 * 【样式锚点】修改样式时关注以下模块:
 *   • .publish-header    : 紫色渐变顶部导航
 *   • .publish-card      : 表单卡片(正文/图片/标签)
 *   • .publish-textarea  : 正文输入框 + 字数计数
 *   • .img-*             : 图片九宫格(选择/删除/预览)
 *   • .tag-*             : 话题标签胶囊
 *   • .scan-tip          : 实时敏感词预警条(黄=mask/ad,红=block)
 *   • .submit-btn        : 底部固定发布按钮(检测中态)
 * ============================================================================ */
.publish-page {
  position: relative;
}

/* ---------- 紫色渐变头部 ---------- */
.publish-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(165deg, #8b6ce0 0%, #7d5bd4 30%, #4a3a8a 62%, #131c3d 100%);
  z-index: 10;
}

.publish-header::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(115deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 45%);
  pointer-events: none;
}

.nav-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
  z-index: 2;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 48rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

/* ---------- 表单卡片 ---------- */
.publish-card {
  margin: 24rpx 28rpx 0;
  background: linear-gradient(160deg, rgba(16, 28, 51, 0.92), rgba(20, 33, 61, 0.92));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 10, 40, 0.35);
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #e6ecf5;
}

.card-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* ---------- 正文 ---------- */
.publish-textarea {
  width: 100%;
  min-height: 260rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.6;
  color: #fff;
}

.ph {
  color: rgba(255, 255, 255, 0.32);
}

.publish-counter {
  text-align: right;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8rpx;
}

/* ---------- 实时敏感词预警条 ---------- */
.scan-tip {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.scan-icon {
  margin-right: 12rpx;
  font-size: 26rpx;
}

.scan-mask,
.scan-ad {
  color: #ffd76a;
  background: rgba(255, 190, 60, 0.12);
  border: 1rpx solid rgba(255, 190, 60, 0.32);
}

.scan-block {
  color: #ff8a8a;
  background: rgba(255, 70, 70, 0.12);
  border: 1rpx solid rgba(255, 70, 70, 0.35);
}

/* ---------- 图片九宫格 ---------- */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}

.img-item,
.img-add {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  height: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.img-item:nth-child(3n) {
  margin-right: 0;
}

.img-thumb {
  width: 100%;
  height: 100%;
}

.img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 32rpx;
  line-height: 42rpx;
  text-align: center;
}

.img-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 200;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx dashed rgba(255, 255, 255, 0.25);
}

/* ---------- 话题标签 ---------- */
.tag-list {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #c9d6ea;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.tag-item.active {
  color: #fff;
  background: linear-gradient(135deg, #8b6ce0, #5a6cf0);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(90, 108, 240, 0.4);
}

/* ---------- 安全提示 ---------- */
.publish-tip {
  margin: 24rpx 28rpx 0;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  padding: 0 8rpx;
  line-height: 1.5;
}

.tip-icon {
  margin-right: 10rpx;
  font-size: 26rpx;
}

/* ---------- 底部发布按钮 ---------- */
.publish-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(11, 19, 38, 0) 0%, rgba(11, 19, 38, 0.85) 35%, rgba(11, 19, 38, 0.95) 100%);
  z-index: 20;
}

.submit-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #8b6ce0 0%, #5a6cf0 50%, #00d4ff 100%);
  box-shadow: 0 10rpx 26rpx rgba(90, 108, 240, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 4rpx;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-btn.is-disabled {
  opacity: 0.6;
  pointer-events: none;
}