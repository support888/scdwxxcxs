<view class="app-container detail-page">
  <view class="tech-element tech-lines"></view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-bar-inner">
      <view class="nav-back" bindtap="goBack">‹</view>
      <view class="nav-title">动态详情</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>
  <view style="height:{{statusBarHeight + 44}}px;"></view>

  <block wx:if="{{feed}}">
    <!-- 动态正文 -->
    <view class="lls-section">
      <view class="detail-card lls-fade-up">
        <view class="feed-head">
          <view class="lls-avatar feed-avatar">{{feed.avatarText}}</view>
          <view class="feed-user">
            <view class="feed-name-row">
              <text class="feed-name">{{feed.name}}</text>
              <text class="feed-gender {{feed.gender === 'f' ? 'female' : ''}}">{{feed.gender === 'f' ? '♀' : '♂'}}</text>
            </view>
            <view class="feed-meta">{{feed.time}} 发布于 {{feed.city}}</view>
          </view>
        </view>

        <view class="feed-content">{{feed.content}}</view>

        <!-- 图片 -->
        <view class="img-grid" wx:if="{{feed.images && feed.images.length > 0}}">
          <image wx:for="{{feed.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"
            class="detail-img" data-index="{{index}}" bindtap="previewImage" />
        </view>
        <!-- 无图兜底封面 -->
        <view class="feed-cover" wx:if="{{(!feed.images || feed.images.length === 0) && feed.cover}}">
          <view class="feed-cover-inner">{{feed.coverText}}</view>
        </view>

        <view class="feed-tag" wx:if="{{feed.tag}}"># {{feed.tag}}</view>

        <!-- 数据统计 -->
        <view class="stat-row">
          <text class="stat-item">👁 {{feed.views}} 浏览</text>
          <text class="stat-item">💬 {{feed.comments}} 评论</text>
          <text class="stat-item">♡ {{feed.likes}} 点赞</text>
        </view>
      </view>
    </view>

    <!-- 互动操作 -->
    <view class="lls-section">
      <view class="action-bar">
        <view class="action-btn {{feed.liked ? 'liked' : ''}}" bindtap="onLike">
          <text class="action-ico">{{feed.liked ? '♥' : '♡'}}</text>
          <text>{{feed.liked ? '已赞' : '点赞'}} {{feed.likes}}</text>
        </view>
        <view class="action-btn" bindtap="focusComment">
          <text class="action-ico">💬</text>
          <text>评论 {{feed.comments}}</text>
        </view>
        <button class="action-btn share-btn" open-type="share">
          <text class="action-ico">↗</text>
          <text>分享</text>
        </button>
      </view>
    </view>

    <!-- 评论列表 -->
    <view class="lls-section">
      <view class="sec-title title_choose">评论({{commentList.length}})</view>
      <block wx:if="{{commentList.length > 0}}">
        <view class="comment-item" wx:for="{{commentList}}" wx:key="id">
          <view class="lls-avatar comment-avatar">{{item.avatarText}}</view>
          <view class="comment-main">
            <view class="comment-top">
              <text class="comment-name">{{item.name}}</text>
              <text class="comment-time">{{item.time}}</text>
            </view>
            <view class="comment-content">{{item.content}}</view>
          </view>
        </view>
      </block>
      <view class="card empty-card" wx:else>
        <view class="empty-ico">💬</view>
        <view class="empty-txt">暂无评论，快来抢沙发~</view>
      </view>
    </view>
  </block>

  <view class="card empty-card big" wx:elif="{{!loading}}">
    <view class="empty-ico">📭</view>
    <view class="empty-txt">动态不存在或已删除</view>
  </view>

  <view style="height:180rpx;"></view>

  <!-- 底部评论输入 -->
  <view class="comment-bar" wx:if="{{feed}}">
    <input class="comment-input" value="{{commentInput}}" focus="{{focusComment}}"
      placeholder="说点什么..." placeholder-class="comment-ph"
      confirm-type="send" bindinput="onCommentInput" bindconfirm="onSubmitComment" />
    <view class="comment-send {{submitting ? 'disabled' : ''}}" bindtap="onSubmitComment">
      {{submitting ? '...' : '发送'}}
    </view>
  </view>
</view>
